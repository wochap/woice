[Desktop Entry]
Type=Application
Name=woice
GenericName=Audio Trimmer
Comment=Trim one audio file precisely on Wayland
Exec=woice %f
Icon=woice
Terminal=false
Categories=AudioVideo;Audio;AudioVideoEditing;
MimeType=audio/mpeg;audio/wav;audio/x-wav;audio/flac;audio/x-flac;audio/ogg;audio/opus;audio/mp4;audio/x-m4a;audio/aac;audio/aiff;audio/x-aiff;video/mp4;video/x-matroska;video/webm;video/quicktime;
StartupWMClass=woice
